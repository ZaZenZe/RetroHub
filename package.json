{
  "name": "retrohub",
  "version": "1.0.0",
  "private": true,
  "description": "Static retro gaming hub with local forum and chatbot (Gemini via server proxy)",
  "scripts": {
    "start": "node server.js",
    "dev": "node server.js",
    "lint": "eslint backend/**/*.js frontend/**/*.js server.js",
    "format": "prettier --write \"**/*.{js,json,md}\"",
    "prepare": "husky",
    "start:auth": "node backend/auth-service/server.js",
    "start:user": "node backend/user-service/server.js",
    "start:game": "node backend/game-service/server.js",
    "start:community": "node backend/community-service/server.js",
    "start:ai": "node backend/ai-service/server.js"
  },
  "dependencies": {
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "http-proxy-middleware": "^3.0.0"
  },
  "devDependencies": {
    "eslint": "^8.57.0",
    "husky": "^9.1.4",
    "lint-staged": "^15.2.10",
    "prettier": "^3.2.5"
  },
  "lint-staged": {
    "*.{js,json,md}": "prettier --write"
  }
}
