{
  "name": "retrohub",
  "version": "1.0.0",
  "private": true,
  "workspaces": {
    "packages": [
      "backend/*-service"
    ]
  },
  "description": "Retro gaming app with AI assistant and community features",
  "scripts": {
    "start": "node server.js",
    "dev:frontend": "cd frontend && npm run dev",
    "dev:full": "docker compose up mongodb -d && concurrently \"npm run start:services\" \"npm run dev:frontend\"",
    "build:frontend": "cd frontend && npm run build",
    "lint": "npx eslint backend/**/*.js",
    "format": "npx prettier --write \"**/*.{js,json,md}\"",
    "prepare": "husky",
    "start:auth": "cd backend/auth-service && npm start",
    "start:user": "cd backend/user-service && npm start",
    "start:game": "cd backend/game-service && npm start",
    "start:community": "cd backend/community-service && npm start",
    "start:ai": "cd backend/ai-service && npm start",
    "start:services": "concurrently \"npm run start:auth\" \"npm run start:user\" \"npm run start:game\" \"npm run start:community\" \"npm run start:ai\""
  },
  "dependencies": {
    "dotenv": "^17.2.3",
    "express": "^5.2.1",
    "http-proxy-middleware": "^3.0.0",
    "mongoose": "^9.1.2",
    "jsonwebtoken": "^9.0.2",
    "bcryptjs": "^3.0.3",
    "cors": "^2.8.5"
  },
  "devDependencies": {
    "concurrently": "^9.2.1",
    "eslint": "^9.39.2",
    "husky": "^9.1.4",
    "lint-staged": "^16.2.7",
    "prettier": "^3.2.5",
    "globals": "^17.0.0"
  },
  "keywords": [
    "retro gaming",
    "AI",
    "community",
    "Node.js",
    "Express",
    "MongoDB"
  ],
  "authors": [
    "Mark",
    "Sayan"
  ],
  "license": "MIT",
  "lint-staged": {
    "*.js": "npx eslint",
    "*.{js,json,md}": "npx prettier --write"
  }
}
